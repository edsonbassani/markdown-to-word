<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    
    <!-- NuGet Package Metadata -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>md2word</ToolCommandName>
    <PackageId>md2word</PackageId>
    <Version>1.0.0</Version>
    <Authors>Edson Bassani</Authors>
    <Company>Edson Bassani</Company>
    <Product>Markdown To Word (md2word)</Product>
    <Description>A powerful .NET CLI tool that converts Markdown documents (including Mermaid diagrams in both Dagre/ELK engines) into professional Word (.docx) documents with full formatting preservation.</Description>
    <PackageTags>markdown;word;docx;converter;mermaid;diagrams;cli;dotnet-tool;dagre;elk</PackageTags>
    <PackageProjectUrl>https://github.com/edsonbassani/markdown-to-word</PackageProjectUrl>
    <RepositoryUrl>https://github.com/edsonbassani/markdown-to-word.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>../README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2025 MarkdownToWord Contributors</Copyright>
    <PackageReleaseNotes>Initial release with support for Markdown conversion, Mermaid diagrams, and dynamic placeholders including ELK and Dagre engines.</PackageReleaseNotes>
    <Title>Markdown To Word (md2word)</Title>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>
  
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\README.md" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Markdig" Version="0.34.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.41.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
  </ItemGroup>
</Project>
